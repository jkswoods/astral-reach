$C = "../../Common.ui";
$A = "Astral.ui";
$C.@PageOverlay { $A.@Window { Anchor: (Width: 900, Height: 720);
 $A.@Header { Anchor: (Left: 8, Right: 8, Top: 8, Height: 56); Group { Anchor: (Left: 0, Width: 34, Height: 42); Background: "Art/CanisterGlyph.png"; HitTestVisible: false; } Label { Anchor: (Left: 50, Right: 0); Text: "OXYGEN DIFFUSER"; Style: (FontName: "Secondary", FontSize: 34, TextColor: #e2eaf0, RenderBold: true, VerticalAlignment: Center); } }
 Group { Anchor: (Left: 26, Right: 26, Top: 80, Bottom: 92); LayoutMode: Top;
  Label #Status { Anchor: (Height: 46); Style: (FontSize: 24, TextColor: #9ed7d1, RenderBold: true); }
  $A.@Section { Anchor: (Height: 252);
   $A.@SectionHeader { Anchor: (Left: 6, Right: 6, Top: 6, Height: 42); Label #CanisterCount { Text: "CANISTERS"; Style: $A.@Heading; } }
   Group { Anchor: (Width: 692, Top: 64, Bottom: 16); LayoutMode: Left;
Group { Anchor: (Width: 140); LayoutMode: Top;
 Group { Anchor: (Height: 124); Background: (TexturePath: "Art/Row.png", Border: 8); ItemSlot #Canister0 { Anchor: (Width: 104, Height: 104); ShowQuantity: false; } }
 $A.@Progress #Charge0 { Anchor: (Height: 12, Left: 8, Right: 8); Value: 0; } Label #ChargeText0 { Anchor: (Height: 34); Style: (FontSize: 24, TextColor: #b7dae3, HorizontalAlignment: Center, VerticalAlignment: Center); } } Group { Anchor: (Width: 44); }
Group { Anchor: (Width: 140); LayoutMode: Top;
 Group { Anchor: (Height: 124); Background: (TexturePath: "Art/Row.png", Border: 8); ItemSlot #Canister1 { Anchor: (Width: 104, Height: 104); ShowQuantity: false; } }
 $A.@Progress #Charge1 { Anchor: (Height: 12, Left: 8, Right: 8); Value: 0; } Label #ChargeText1 { Anchor: (Height: 34); Style: (FontSize: 24, TextColor: #b7dae3, HorizontalAlignment: Center, VerticalAlignment: Center); } } Group { Anchor: (Width: 44); }
Group { Anchor: (Width: 140); LayoutMode: Top;
 Group { Anchor: (Height: 124); Background: (TexturePath: "Art/Row.png", Border: 8); ItemSlot #Canister2 { Anchor: (Width: 104, Height: 104); ShowQuantity: false; } }
 $A.@Progress #Charge2 { Anchor: (Height: 12, Left: 8, Right: 8); Value: 0; } Label #ChargeText2 { Anchor: (Height: 34); Style: (FontSize: 24, TextColor: #b7dae3, HorizontalAlignment: Center, VerticalAlignment: Center); } } Group { Anchor: (Width: 44); }
Group { Anchor: (Width: 140); LayoutMode: Top;
 Group { Anchor: (Height: 124); Background: (TexturePath: "Art/Row.png", Border: 8); ItemSlot #Canister3 { Anchor: (Width: 104, Height: 104); ShowQuantity: false; } }
 $A.@Progress #Charge3 { Anchor: (Height: 12, Left: 8, Right: 8); Value: 0; } Label #ChargeText3 { Anchor: (Height: 34); Style: (FontSize: 24, TextColor: #b7dae3, HorizontalAlignment: Center, VerticalAlignment: Center); } }
   }
  }
  Group { Anchor: (Height: 16); }
  $A.@Section { Anchor: (Height: 160);
   $A.@SectionHeader { Anchor: (Left: 6, Right: 6, Top: 6, Height: 42); Label { Text: "FIELD"; Style: $A.@Heading; } }
   ItemSlot { Anchor: (Left: 26, Top: 66, Width: 72, Height: 72); ItemId: "AR_OxygenDiffuser"; ShowQuantity: false; }
   Label #Field { Anchor: (Left: 122, Right: 22, Top: 58, Height: 92); Style: (FontSize: 25, TextColor: #bddbe1, Wrap: true); }
  }
  Group { Anchor: (Height: 18); }
  Group { Anchor: (Height: 50); LayoutMode: Left; $A.@Secondary #Load { Anchor: (Width: 412, Height: 46); Text: "Load one canister"; } Group { Anchor: (Width: 16); } $A.@Secondary #Collect { Anchor: (Width: 412, Height: 46); Text: "Collect all"; } }
 }
 $A.@Rule { Anchor: (Left: 24, Right: 24, Bottom: 82, Height: 1); }
 $A.@Secondary #Close { Anchor: (Left: 28, Bottom: 24, Width: 180, Height: 46); Text: "Close"; }
 $A.@Primary #Toggle { Anchor: (Right: 28, Bottom: 24, Width: 330, Height: 46); Text: "Switch on"; }
} }
