$A.@Section { Anchor: (Left: 424, Top: 750, Width: 716, Height: 100);
ItemIcon #NextIcon { Anchor: (Left: 14, Top: 18, Width: 64, Height: 64); ItemId: "AR_ComponentPress"; }
Label { Anchor: (Left: 95, Top: 9, Right: 18, Height: 24); Text: "YOUR NEXT STEP"; Style: (FontSize: 18, RenderBold: true, TextColor: #eeb978); }
Label #Next { Anchor: (Left: 95, Top: 35, Right: 18, Height: 30); Style: (FontSize: 21, RenderBold: true, TextColor: #f3f0e3); }
