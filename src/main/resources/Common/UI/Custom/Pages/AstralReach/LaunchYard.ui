$C = "../../Common.ui";
$A = "Astral.ui";
@Small = (FontSize: 18, TextColor: #9aafc2, VerticalAlignment: Center);
@Count = (FontSize: 21, TextColor: #cbd9e1, VerticalAlignment: Center, HorizontalAlignment: Center);
@CardStyle = ButtonStyle(Default: (Background: (TexturePath: "Art/RocketCardFrame.png", Border: 8)), Hovered: (Background: (TexturePath: "Art/RocketCardHover.png", Border: 8)), Pressed: (Background: (TexturePath: "Art/RocketCardPressed.png", Border: 8)), Sounds: $C.@ButtonSounds);
$C.@PageOverlay { $A.@Window #YardPanel { Anchor: (Width: 1260, Height: 900);
 $A.@Header { Anchor: (Left: 8, Right: 8, Top: 8, Height: 64); Group { Anchor: (Left: 0, Width: 34, Height: 42); Background: "Art/RocketGlyph.png"; HitTestVisible: false; } Label { Anchor: (Left: 50, Right: 0); Text: "LAUNCH PLATFORM"; Style: (FontName: "Secondary", FontSize: 36, TextColor: #e0e9ee, VerticalAlignment: Center); } }
 $A.@Section { Anchor: (Left: 28, Top: 86, Width: 520, Height: 680);
  Group #PreviewODYSSEY { Anchor: (Left: 10, Top: 12, Width: 500, Height: 605); Background: "Art/RocketBuild_Odyssey.png"; HitTestVisible: false; }
  Group #PreviewKESTREL { Anchor: (Left: 10, Top: 12, Width: 500, Height: 605); Background: "Art/RocketBuild_Kestrel.png"; HitTestVisible: false; }
  Group #PreviewSATURNV { Anchor: (Left: 10, Top: 12, Width: 500, Height: 605); Background: "Art/RocketBuild_SaturnV.png"; HitTestVisible: false; }
  Group #PreviewSOYUZ { Anchor: (Left: 10, Top: 12, Width: 500, Height: 605); Background: "Art/RocketBuild_Soyuz.png"; HitTestVisible: false; }
  Group #PreviewSPACESHUTTLE { Anchor: (Left: 10, Top: 12, Width: 500, Height: 605); Background: "Art/RocketBuild_SpaceShuttle.png"; HitTestVisible: false; }
  $A.@SectionHeader { Anchor: (Left: 18, Top: 18, Width: 200, Height: 36); Label { Text: "BLUEPRINT"; Style: $A.@Heading; } }
  Label #PreviewName { Anchor: (Left: 20, Top: 62, Width: 180, Height: 54); Style: (FontSize: 24, TextColor: #d5e4eb, Wrap: true, VerticalAlignment: Start); }
  Group { Anchor: (Left: 404, Top: 34, Width: 1, Height: 562); Background: #79a8c1; HitTestVisible: false; }
  Group { Anchor: (Left: 398, Top: 34, Width: 13, Height: 1); Background: #79a8c1; HitTestVisible: false; }
  Group { Anchor: (Left: 398, Top: 595, Width: 13, Height: 1); Background: #79a8c1; HitTestVisible: false; }
  Label #PreviewHeight { Anchor: (Left: 418, Top: 280, Width: 84, Height: 60); Style: (FontSize: 22, TextColor: #b9dce8, Wrap: true, VerticalAlignment: Center); }
  Label #Dimensions { Anchor: (Left: 20, Right: 20, Top: 624, Height: 28); Style: (FontSize: 21, TextColor: #b8ccdf, VerticalAlignment: Center); }
  Label #Recovery { Anchor: (Left: 20, Right: 20, Top: 653, Height: 22); Style: @Small; }
 }
 Group { Anchor: (Left: 574, Right: 28, Top: 86, Bottom: 104);
  $A.@Section { Anchor: (Left: 0, Right: 0, Top: 0, Height: 98);
   Label #Blueprint { Anchor: (Left: 16, Right: 16, Top: 8, Height: 44); Style: (FontSize: 36, TextColor: #e0e9ee, RenderBold: true, RenderUppercase: true, VerticalAlignment: Center); }
   Label #Status { Anchor: (Left: 16, Right: 16, Top: 54, Height: 32); Style: (FontSize: 24, TextColor: #d1dfe2, VerticalAlignment: Center); }
  }
  $A.@Section #Materials { Anchor: (Left: 0, Right: 0, Top: 112, Height: 318);
   $A.@SectionHeader { Anchor: (Left: 2, Right: 2, Top: 2, Height: 40); Label { Text: "ASSEMBLY MATERIALS"; Style: $A.@Heading; } }
   Group { Anchor: (Left: 294, Top: 48, Bottom: 12, Width: 1); Background: #29465a; HitTestVisible: false; }
   Group { Anchor: (Left: 410, Top: 48, Bottom: 12, Width: 1); Background: #29465a; HitTestVisible: false; }
   Group { Anchor: (Left: 526, Top: 48, Bottom: 12, Width: 1); Background: #29465a; HitTestVisible: false; }
   Group { Anchor: (Left: 16, Right: 16, Top: 48, Height: 34); LayoutMode: Left;
    Label { Anchor: (Width: 278); Text: "Part"; Style: @Small; }
    Label { Anchor: (Width: 116); Text: "Required"; Style: (FontSize: 18, TextColor: #9aafc2, HorizontalAlignment: Center, VerticalAlignment: Center); }
    Label { Anchor: (Width: 116); Text: "Supplied"; Style: (FontSize: 18, TextColor: #9aafc2, HorizontalAlignment: Center, VerticalAlignment: Center); }
    Label { Anchor: (Width: 116); Text: "In pack"; Style: (FontSize: 18, TextColor: #9aafc2, HorizontalAlignment: Center, VerticalAlignment: Center); }
   }
   Group { Anchor: (Left: 16, Right: 16, Top: 86, Bottom: 12); LayoutMode: Top;
    Group #Material0 { FlexWeight: 1;
     Group { Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 1); LayoutMode: Left;
      ItemIcon #Icon { Anchor: (Width: 44, Height: 44); ShowItemTooltip: true; } Group { Anchor: (Width: 6); }
      Label #Count { Anchor: (Width: 228); Style: (FontSize: 21, TextColor: #cbd9e1, VerticalAlignment: Center); }
      Label #Required { Anchor: (Width: 116); Style: @Count; } Label #Supplied { Anchor: (Width: 116); Style: @Count; } Label #Carried { Anchor: (Width: 116); Style: @Count; }
     } $A.@Rule { Anchor: (Left: 0, Right: 0, Bottom: 0, Height: 1); }
    }
    Group #Material1 { FlexWeight: 1;
     Group { Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 1); LayoutMode: Left;
      ItemIcon #Icon { Anchor: (Width: 44, Height: 44); ShowItemTooltip: true; } Group { Anchor: (Width: 6); }
      Label #Count { Anchor: (Width: 228); Style: (FontSize: 21, TextColor: #cbd9e1, VerticalAlignment: Center); }
      Label #Required { Anchor: (Width: 116); Style: @Count; } Label #Supplied { Anchor: (Width: 116); Style: @Count; } Label #Carried { Anchor: (Width: 116); Style: @Count; }
     } $A.@Rule { Anchor: (Left: 0, Right: 0, Bottom: 0, Height: 1); }
    }
    Group #Material2 { FlexWeight: 1;
     Group { Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 1); LayoutMode: Left;
      ItemIcon #Icon { Anchor: (Width: 44, Height: 44); ShowItemTooltip: true; } Group { Anchor: (Width: 6); }
      Label #Count { Anchor: (Width: 228); Style: (FontSize: 21, TextColor: #cbd9e1, VerticalAlignment: Center); }
      Label #Required { Anchor: (Width: 116); Style: @Count; } Label #Supplied { Anchor: (Width: 116); Style: @Count; } Label #Carried { Anchor: (Width: 116); Style: @Count; }
     } $A.@Rule { Anchor: (Left: 0, Right: 0, Bottom: 0, Height: 1); }
    }
    Group #Material3 { FlexWeight: 1;
     Group { Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 1); LayoutMode: Left;
      ItemIcon #Icon { Anchor: (Width: 44, Height: 44); ShowItemTooltip: true; } Group { Anchor: (Width: 6); }
      Label #Count { Anchor: (Width: 228); Style: (FontSize: 21, TextColor: #cbd9e1, VerticalAlignment: Center); }
      Label #Required { Anchor: (Width: 116); Style: @Count; } Label #Supplied { Anchor: (Width: 116); Style: @Count; } Label #Carried { Anchor: (Width: 116); Style: @Count; }
     } $A.@Rule { Anchor: (Left: 0, Right: 0, Bottom: 0, Height: 1); }
    }
    Group #Material4 { FlexWeight: 1;
     Group { Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 1); LayoutMode: Left;
      ItemIcon #Icon { Anchor: (Width: 44, Height: 44); ShowItemTooltip: true; } Group { Anchor: (Width: 6); }
      Label #Count { Anchor: (Width: 228); Style: (FontSize: 21, TextColor: #cbd9e1, VerticalAlignment: Center); }
      Label #Required { Anchor: (Width: 116); Style: @Count; } Label #Supplied { Anchor: (Width: 116); Style: @Count; } Label #Carried { Anchor: (Width: 116); Style: @Count; }
     } $A.@Rule { Anchor: (Left: 0, Right: 0, Bottom: 0, Height: 1); }
    }
   }
  }
  $A.@Section { Anchor: (Left: 0, Right: 0, Top: 444, Height: 82);
   Label #ProgressText { Anchor: (Left: 16, Top: 9, Width: 290, Height: 30); Style: (FontSize: 23, TextColor: #cbd9e1, VerticalAlignment: Center); }
   $A.@Progress #Progress { Anchor: (Left: 16, Top: 50, Width: 280, Height: 14); Value: 0; }
   Label { Anchor: (Right: 16, Top: 12, Width: 316, Height: 56); Text: "Only needed quantities are supplied from your pack."; Style: (FontSize: 18, TextColor: #9aafc2, Wrap: true, VerticalAlignment: Center); }
  }
  $A.@Section { Anchor: (Left: 0, Right: 0, Top: 540, Height: 128);
   $A.@SectionHeader { Anchor: (Left: 2, Right: 2, Top: 2, Height: 32); Label { Text: "SITE CHECK"; Style: $A.@Heading; } }
   Label #Footprint { Anchor: (Left: 16, Top: 40, Width: 320, Height: 28); Style: (FontSize: 19, TextColor: #b9d6cf, VerticalAlignment: Center); }
   Label #Site { Anchor: (Left: 16, Top: 74, Width: 320, Height: 46); Style: (FontSize: 18, TextColor: #9aafc2, Wrap: true, VerticalAlignment: Center); }
   Label #BuildInfo { Anchor: (Left: 356, Right: 16, Top: 42, Height: 78); Style: (FontSize: 18, TextColor: #b8ccdf, Wrap: true, VerticalAlignment: Center); }
  }
 }
 Label #Help { Anchor: (Left: 30, Right: 30, Bottom: 92, Height: 34); Style: (FontSize: 20, TextColor: #9aafc2, VerticalAlignment: Center); }
 $A.@Rule { Anchor: (Left: 24, Right: 24, Bottom: 82, Height: 1); }
 $A.@Secondary #Close { Anchor: (Left: 28, Bottom: 24, Width: 160, Height: 46); Text: "Close"; }
 $A.@Secondary #Change { Anchor: (Left: 206, Bottom: 24, Width: 240, Height: 46); Text: "Change rocket"; }
 $A.@Secondary #Cancel { Anchor: (Left: 206, Bottom: 24, Width: 300, Height: 46); Text: "Return supplied parts"; }
 $A.@Primary #Deposit { Anchor: (Right: 28, Bottom: 24, Width: 390, Height: 46); Text: "Supply carried parts"; }
 $A.@Primary #Build { Anchor: (Right: 28, Bottom: 24, Width: 390, Height: 46); Text: "Retry construction"; }
 $A.@Primary #Flight { Anchor: (Right: 28, Bottom: 24, Width: 390, Height: 46); Text: "Open flight control"; }
} }
