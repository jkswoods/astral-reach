 Label { Anchor: (Left: 30, Right: 30, Bottom: 92, Height: 26); Text: "Select a blueprint to see its full-size ghost and supply construction parts."; Style: @Small; }
 $A.@Rule { Anchor: (Left: 24, Right: 24, Bottom: 82, Height: 1); }
 $A.@Secondary #Close { Anchor: (Left: 28, Bottom: 24, Width: 160, Height: 46); Text: "Close"; }
 Label { Anchor: (Left: 212, Bottom: 26, Width: 680, Height: 44); Text: "Current destination: Lune · Rocket range progression comes later"; Style: @Small; }
 $A.@Secondary #Rotate { Anchor: (Right: 28, Bottom: 24, Width: 248, Height: 46); Text: "Pad: NORTH"; }
} }
