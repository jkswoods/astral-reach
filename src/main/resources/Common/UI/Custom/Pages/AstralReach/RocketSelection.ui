$C = "../../Common.ui";
$A = "Astral.ui";
@Small = (FontSize: 18, TextColor: #9aafc2, VerticalAlignment: Center);
@Count = (FontSize: 21, TextColor: #cbd9e1, VerticalAlignment: Center, HorizontalAlignment: Center);
@CardStyle = ButtonStyle(Default: (Background: (TexturePath: "Art/RocketCardFrame.png", Border: 8)), Hovered: (Background: (TexturePath: "Art/RocketCardHover.png", Border: 8)), Pressed: (Background: (TexturePath: "Art/RocketCardPressed.png", Border: 8)), Sounds: $C.@ButtonSounds);
$C.@PageOverlay { $A.@Window #YardPanel { Anchor: (Width: 1260, Height: 900);
 $A.@Header { Anchor: (Left: 8, Right: 8, Top: 8, Height: 64); Group { Anchor: (Left: 0, Width: 34, Height: 42); Background: "Art/RocketGlyph.png"; HitTestVisible: false; } Label { Anchor: (Left: 50, Right: 0); Text: "LAUNCH PLATFORM"; Style: (FontName: "Secondary", FontSize: 36, TextColor: #e0e9ee, VerticalAlignment: Center); } }
 Label { Anchor: (Left: 30, Top: 82, Width: 580, Height: 38); Text: "Choose your rocket"; Style: (FontSize: 28, TextColor: #dce5ec, VerticalAlignment: Center); }
 Label #Footprint { Anchor: (Right: 32, Top: 82, Width: 560, Height: 38); Style: (FontSize: 21, TextColor: #b6ced2, HorizontalAlignment: End, VerticalAlignment: Center); }
 Button #SelectODYSSEY { Anchor: (Left: 30, Top: 130, Width: 384, Height: 318); Style: @CardStyle;
  Label { Anchor: (Left: 16, Right: 16, Top: 224, Height: 32); Text: "Odyssey Heavy"; Style: (FontSize: 27, RenderBold: true, TextColor: #dce5e8, VerticalAlignment: Center); HitTestVisible: false; }
  Group { Anchor: (Left: 17, Top: 10, Width: 350, Height: 208); Background: "Art/RocketCard_Odyssey.png"; HitTestVisible: false; }
  Group { Anchor: (Left: 278, Top: 30, Width: 1, Height: 166); Background: #79a8c1; HitTestVisible: false; }
  Group { Anchor: (Left: 273, Top: 30, Width: 11, Height: 1); Background: #79a8c1; HitTestVisible: false; }
  Group { Anchor: (Left: 273, Top: 195, Width: 11, Height: 1); Background: #79a8c1; HitTestVisible: false; }
  Label #Height { Anchor: (Left: 288, Top: 90, Width: 84, Height: 54); Style: (FontSize: 20, TextColor: #b9dce8, Wrap: true, VerticalAlignment: Center); HitTestVisible: false; }
  Label #Dimensions { Anchor: (Left: 16, Right: 16, Top: 256, Height: 24); Style: @Small; HitTestVisible: false; }
  Group { Anchor: (Left: 14, Right: 14, Top: 280, Height: 36); LayoutMode: Left; HitTestVisible: false;
   Group #Cost0 { Anchor: (Width: 71, Height: 36); LayoutMode: Left; ItemIcon #Icon { Anchor: (Width: 36, Height: 36); } Label #Quantity { Anchor: (Width: 30); Style: @Count; } }
   Group #Cost1 { Anchor: (Width: 71, Height: 36); LayoutMode: Left; ItemIcon #Icon { Anchor: (Width: 36, Height: 36); } Label #Quantity { Anchor: (Width: 30); Style: @Count; } }
   Group #Cost2 { Anchor: (Width: 71, Height: 36); LayoutMode: Left; ItemIcon #Icon { Anchor: (Width: 36, Height: 36); } Label #Quantity { Anchor: (Width: 30); Style: @Count; } }
   Group #Cost3 { Anchor: (Width: 71, Height: 36); LayoutMode: Left; ItemIcon #Icon { Anchor: (Width: 36, Height: 36); } Label #Quantity { Anchor: (Width: 30); Style: @Count; } }
   Group #Cost4 { Anchor: (Width: 71, Height: 36); LayoutMode: Left; ItemIcon #Icon { Anchor: (Width: 36, Height: 36); } Label #Quantity { Anchor: (Width: 30); Style: @Count; } }
  }
 }
 Button #SelectKESTREL { Anchor: (Left: 432, Top: 130, Width: 384, Height: 318); Style: @CardStyle;
  Label { Anchor: (Left: 16, Right: 16, Top: 224, Height: 32); Text: "Kestrel Stack"; Style: (FontSize: 27, RenderBold: true, TextColor: #dce5e8, VerticalAlignment: Center); HitTestVisible: false; }
  Group { Anchor: (Left: 17, Top: 10, Width: 350, Height: 208); Background: "Art/RocketCard_Kestrel.png"; HitTestVisible: false; }
