  Label #Dimensions { Anchor: (Left: 16, Right: 16, Top: 256, Height: 24); Style: @Small; HitTestVisible: false; }
  Group { Anchor: (Left: 14, Right: 14, Top: 280, Height: 36); LayoutMode: Left; HitTestVisible: false;
   Group #Cost0 { Anchor: (Width: 71, Height: 36); LayoutMode: Left; ItemIcon #Icon { Anchor: (Width: 36, Height: 36); } Label #Quantity { Anchor: (Width: 30); Style: @Count; } }
   Group #Cost1 { Anchor: (Width: 71, Height: 36); LayoutMode: Left; ItemIcon #Icon { Anchor: (Width: 36, Height: 36); } Label #Quantity { Anchor: (Width: 30); Style: @Count; } }
   Group #Cost2 { Anchor: (Width: 71, Height: 36); LayoutMode: Left; ItemIcon #Icon { Anchor: (Width: 36, Height: 36); } Label #Quantity { Anchor: (Width: 30); Style: @Count; } }
   Group #Cost3 { Anchor: (Width: 71, Height: 36); LayoutMode: Left; ItemIcon #Icon { Anchor: (Width: 36, Height: 36); } Label #Quantity { Anchor: (Width: 30); Style: @Count; } }
   Group #Cost4 { Anchor: (Width: 71, Height: 36); LayoutMode: Left; ItemIcon #Icon { Anchor: (Width: 36, Height: 36); } Label #Quantity { Anchor: (Width: 30); Style: @Count; } }
  }
 }
