$C = "../../Common.ui";
$A = "Astral.ui";
@Text = (FontSize: 22, TextColor: #d2e0e7, VerticalAlignment: Center);
@Small = (FontSize: 19, TextColor: #9eB3c4, VerticalAlignment: Center, Wrap: true);
$C.@PageOverlay { $A.@Window { Anchor: (Width: 1440, Height: 860);
 $A.@Header { Anchor: (Left: 8, Right: 8, Top: 8, Height: 64);
  Group { Anchor: (Left: 0, Width: 34, Height: 42); Background: "Art/RocketGlyph.png"; HitTestVisible: false; }
  Label { Anchor: (Left: 50, Width: 430); Text: "ORBIS STATIONS"; Style: (FontName: "Secondary", FontSize: 36, TextColor: #e4edf2, VerticalAlignment: Center); }
  Label { Anchor: (Left: 500, Right: 20); Text: "Build your orbital outpost"; Style: (FontSize: 25, TextColor: #a5c5da, VerticalAlignment: Center); }
 }
 $A.@Section { Anchor: (Left: 20, Top: 90, Width: 300, Height: 650);
  $A.@SectionHeader { Anchor: (Left: 2, Right: 2, Top: 2, Height: 42); Label #ListHeading { Style: $A.@Heading; } }
  Group { Anchor: (Left: 10, Right: 10, Top: 54, Height: 492); LayoutMode: Top;
   Button #Row0 { Anchor: (Height: 76); Style: $A.@RowStyle;
    Group #Chosen { Anchor: (Full: 2); Background: (TexturePath: "Art/SelectedFrame.png", Border: 7); HitTestVisible: false; }
    ItemIcon #Icon { Anchor: (Left: 6, Top: 10, Width: 52, Height: 52); HitTestVisible: false; }
    Label #Name { Anchor: (Left: 66, Right: 8, Top: 10, Height: 28); Style: (FontSize: 22, TextColor: #e0e8ea, RenderBold: true, VerticalAlignment: Center); HitTestVisible: false; }
    Label #Note { Anchor: (Left: 66, Right: 8, Top: 42, Height: 24); Style: (FontSize: 18, TextColor: #9eb8ca, VerticalAlignment: Center); HitTestVisible: false; }
    $A.@Secondary #Remove { Anchor: (Right: 6, Bottom: 4, Width: 88, Height: 30); Text: "Remove"; }
   } Group { Anchor: (Height: 6); }
   Button #Row1 { Anchor: (Height: 76); Style: $A.@RowStyle;
    Group #Chosen { Anchor: (Full: 2); Background: (TexturePath: "Art/SelectedFrame.png", Border: 7); HitTestVisible: false; }
    ItemIcon #Icon { Anchor: (Left: 6, Top: 10, Width: 52, Height: 52); HitTestVisible: false; }
    Label #Name { Anchor: (Left: 66, Right: 8, Top: 10, Height: 28); Style: (FontSize: 22, TextColor: #e0e8ea, RenderBold: true, VerticalAlignment: Center); HitTestVisible: false; }
    Label #Note { Anchor: (Left: 66, Right: 8, Top: 42, Height: 24); Style: (FontSize: 18, TextColor: #9eb8ca, VerticalAlignment: Center); HitTestVisible: false; }
    $A.@Secondary #Remove { Anchor: (Right: 6, Bottom: 4, Width: 88, Height: 30); Text: "Remove"; }
   } Group { Anchor: (Height: 6); }
   Button #Row2 { Anchor: (Height: 76); Style: $A.@RowStyle;
    Group #Chosen { Anchor: (Full: 2); Background: (TexturePath: "Art/SelectedFrame.png", Border: 7); HitTestVisible: false; }
    ItemIcon #Icon { Anchor: (Left: 6, Top: 10, Width: 52, Height: 52); HitTestVisible: false; }
    Label #Name { Anchor: (Left: 66, Right: 8, Top: 10, Height: 28); Style: (FontSize: 22, TextColor: #e0e8ea, RenderBold: true, VerticalAlignment: Center); HitTestVisible: false; }
    Label #Note { Anchor: (Left: 66, Right: 8, Top: 42, Height: 24); Style: (FontSize: 18, TextColor: #9eb8ca, VerticalAlignment: Center); HitTestVisible: false; }
    $A.@Secondary #Remove { Anchor: (Right: 6, Bottom: 4, Width: 88, Height: 30); Text: "Remove"; }
   } Group { Anchor: (Height: 6); }
   Button #Row3 { Anchor: (Height: 76); Style: $A.@RowStyle;
    Group #Chosen { Anchor: (Full: 2); Background: (TexturePath: "Art/SelectedFrame.png", Border: 7); HitTestVisible: false; }
    ItemIcon #Icon { Anchor: (Left: 6, Top: 10, Width: 52, Height: 52); HitTestVisible: false; }
    Label #Name { Anchor: (Left: 66, Right: 8, Top: 10, Height: 28); Style: (FontSize: 22, TextColor: #e0e8ea, RenderBold: true, VerticalAlignment: Center); HitTestVisible: false; }
    Label #Note { Anchor: (Left: 66, Right: 8, Top: 42, Height: 24); Style: (FontSize: 18, TextColor: #9eb8ca, VerticalAlignment: Center); HitTestVisible: false; }
    $A.@Secondary #Remove { Anchor: (Right: 6, Bottom: 4, Width: 88, Height: 30); Text: "Remove"; }
   } Group { Anchor: (Height: 6); }
   Button #Row4 { Anchor: (Height: 76); Style: $A.@RowStyle;
    Group #Chosen { Anchor: (Full: 2); Background: (TexturePath: "Art/SelectedFrame.png", Border: 7); HitTestVisible: false; }
    ItemIcon #Icon { Anchor: (Left: 6, Top: 10, Width: 52, Height: 52); HitTestVisible: false; }
    Label #Name { Anchor: (Left: 66, Right: 8, Top: 10, Height: 28); Style: (FontSize: 22, TextColor: #e0e8ea, RenderBold: true, VerticalAlignment: Center); HitTestVisible: false; }
    Label #Note { Anchor: (Left: 66, Right: 8, Top: 42, Height: 24); Style: (FontSize: 18, TextColor: #9eb8ca, VerticalAlignment: Center); HitTestVisible: false; }
    $A.@Secondary #Remove { Anchor: (Right: 6, Bottom: 4, Width: 88, Height: 30); Text: "Remove"; }
   } Group { Anchor: (Height: 6); }
   Button #Row5 { Anchor: (Height: 76); Style: $A.@RowStyle;
    Group #Chosen { Anchor: (Full: 2); Background: (TexturePath: "Art/SelectedFrame.png", Border: 7); HitTestVisible: false; }
    ItemIcon #Icon { Anchor: (Left: 6, Top: 10, Width: 52, Height: 52); HitTestVisible: false; }
    Label #Name { Anchor: (Left: 66, Right: 8, Top: 10, Height: 28); Style: (FontSize: 22, TextColor: #e0e8ea, RenderBold: true, VerticalAlignment: Center); HitTestVisible: false; }
    Label #Note { Anchor: (Left: 66, Right: 8, Top: 42, Height: 24); Style: (FontSize: 18, TextColor: #9eb8ca, VerticalAlignment: Center); HitTestVisible: false; }
    $A.@Secondary #Remove { Anchor: (Right: 6, Bottom: 4, Width: 88, Height: 30); Text: "Remove"; }
   } Group { Anchor: (Height: 6); }
  }
  Label #Empty { Anchor: (Left: 20, Right: 20, Top: 68, Height: 60); Style: @Small; }
  Group #InviteBox { Anchor: (Left: 12, Right: 12, Bottom: 56, Height: 42);
   $C.@TextField #GuestName { Anchor: (Left: 0, Width: 180, Height: 42); MaxLength: 64; PlaceholderText: "Online player name"; }
   $A.@Secondary #Invite { Anchor: (Right: 0, Width: 88, Height: 42); Text: "Invite"; }
  }
  $A.@Secondary #Previous { Anchor: (Left: 12, Bottom: 12, Width: 96, Height: 34); Text: "Previous"; }
  Label #Page { Anchor: (Left: 114, Bottom: 12, Width: 60, Height: 34); Style: (FontSize: 18, TextColor: #b9d3df, HorizontalAlignment: Center, VerticalAlignment: Center); }
  $A.@Secondary #Next { Anchor: (Right: 12, Bottom: 12, Width: 96, Height: 34); Text: "Next"; }
 }
 $A.@Section { Anchor: (Left: 334, Top: 90, Width: 560, Height: 650);
  $A.@SectionHeader { Anchor: (Left: 2, Right: 2, Top: 2, Height: 42); Label { Text: "STATION PREVIEW"; Style: $A.@Heading; } }
  Group { Anchor: (Left: 12, Top: 54, Width: 536, Height: 526); Background: "Art/StationStarter.png"; HitTestVisible: false; }
  Label { Anchor: (Left: 18, Right: 18, Bottom: 12, Height: 48); Text: "Three starter platforms · example docked ships"; Style: @Text; }
 }
 Group { Anchor: (Left: 908, Top: 90, Width: 512, Height: 650);
  $A.@Section { Anchor: (Left: 0, Right: 0, Top: 0, Height: 90);
   Label #Title { Anchor: (Left: 16, Right: 16, Top: 8, Height: 38); Style: (FontSize: 30, TextColor: #e3edf1, RenderBold: true, VerticalAlignment: Center); }
   Label #Status { Anchor: (Left: 16, Right: 16, Top: 50, Height: 28); Style: (FontSize: 22, TextColor: #75d7cd, VerticalAlignment: Center); }
  }
  $A.@Section #CorePanel { Anchor: (Left: 0, Right: 0, Top: 104, Height: 128);
   $A.@SectionHeader { Anchor: (Left: 2, Right: 2, Top: 2, Height: 36); Label #CoreHeading { Text: "REQUIRED ITEM"; Style: $A.@Heading; } }
   ItemIcon #CoreItem { Anchor: (Left: 16, Top: 52, Width: 60, Height: 60); ShowItemTooltip: true; }
   Label #CoreLabel { Anchor: (Left: 86, Top: 52, Width: 218, Height: 60); Style: @Text; }
   Label #CoreColumn { Anchor: (Left: 314, Top: 44, Width: 88, Height: 28); Text: "Required"; Style: @Small; }
   Label { Anchor: (Right: 16, Top: 44, Width: 80, Height: 28); Text: "In pack"; Style: @Small; }
   Label #CoreRequired { Anchor: (Left: 314, Top: 78, Width: 88, Height: 32); Style: (FontSize: 25, TextColor: #cddfe8, HorizontalAlignment: Center, VerticalAlignment: Center); }
   Label #CoreCarried { Anchor: (Right: 16, Top: 78, Width: 80, Height: 32); Style: (FontSize: 25, TextColor: #cddfe8, HorizontalAlignment: Center, VerticalAlignment: Center); }
  }
  $A.@Section { Anchor: (Left: 0, Right: 0, Top: 246, Height: 218);
   $A.@SectionHeader { Anchor: (Left: 2, Right: 2, Top: 2, Height: 38); Label #InfoHeading { Style: $A.@Heading; } }
   ItemIcon { Anchor: (Left: 16, Top: 46, Width: 34, Height: 34); ItemId: "AR_StationDeck"; }
   Label #Info0 { Anchor: (Left: 62, Right: 14, Top: 46, Height: 34); Style: @Text; }
   ItemIcon { Anchor: (Left: 16, Top: 86, Width: 34, Height: 34); ItemId: "AR_StationRail"; }
   Label #Info1 { Anchor: (Left: 62, Right: 14, Top: 86, Height: 34); Style: @Text; }
   ItemIcon { Anchor: (Left: 16, Top: 126, Width: 34, Height: 34); ItemId: "AR_StationCore"; }
   Label #Info2 { Anchor: (Left: 62, Right: 14, Top: 126, Height: 34); Style: @Text; }
   ItemIcon { Anchor: (Left: 16, Top: 166, Width: 34, Height: 34); ItemId: "AR_OxygenDiffuser"; }
   Label #Info3 { Anchor: (Left: 62, Right: 14, Top: 166, Height: 34); Style: @Text; }
  }
  $A.@Section { Anchor: (Left: 0, Right: 0, Top: 478, Height: 172);
   $A.@SectionHeader { Anchor: (Left: 2, Right: 2, Top: 2, Height: 36); Label { Text: "TRAVEL READINESS"; Style: $A.@Heading; } }
   ItemIcon { Anchor: (Left: 16, Top: 44, Width: 36, Height: 36); ItemId: "AR_Survey_Chest"; }
   Label #Suit { Anchor: (Left: 64, Right: 16, Top: 44, Height: 36); Style: @Text; }
   $A.@Rule { Anchor: (Left: 16, Right: 16, Top: 84, Height: 1); }
   ItemIcon { Anchor: (Left: 16, Top: 88, Width: 34, Height: 34); ItemId: "AR_OxygenCanister"; }
   Label #Oxygen { Anchor: (Left: 64, Right: 16, Top: 88, Height: 34); Style: @Text; }
   $A.@Rule { Anchor: (Left: 16, Right: 16, Top: 126, Height: 1); }
   ItemIcon { Anchor: (Left: 16, Top: 132, Width: 32, Height: 32); ItemId: "AR_PropellantCell"; }
   Label #Reserve { Anchor: (Left: 64, Right: 16, Top: 130, Height: 36); Style: @Text; }
  }
 }
 Label #Hint { Anchor: (Left: 28, Right: 28, Bottom: 76, Height: 32); Style: @Small; }
 $A.@Rule { Anchor: (Left: 24, Right: 24, Bottom: 70, Height: 1); }
 $A.@Secondary #Systems { Anchor: (Left: 254, Bottom: 18, Width: 270, Height: 46); Text: "Station systems"; }
 $A.@Secondary #Close { Anchor: (Left: 28, Bottom: 18, Width: 210, Height: 46); Text: "Close"; }
 $A.@Primary #Deploy { Anchor: (Right: 20, Bottom: 18, Width: 512, Height: 46); Text: "Deploy station core"; }
 $A.@Primary #Dock { Anchor: (Right: 20, Bottom: 18, Width: 512, Height: 46); Text: "Dock at station"; }
 $A.@Secondary #Undock { Anchor: (Right: 284, Bottom: 18, Width: 248, Height: 46); Text: "Orbital navigation"; }
 $A.@Primary #Home { Anchor: (Right: 20, Bottom: 18, Width: 248, Height: 46); Text: "Return to Orbis"; }
} }
