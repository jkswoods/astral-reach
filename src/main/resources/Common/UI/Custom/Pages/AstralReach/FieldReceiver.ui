Group #BlueprintHero2 { HitTestVisible: false; Anchor: (Left: 86, Top: 102, Width: 728, Height: 420); Background: "Art/BlueprintLunarRover.png"; }
Label #BlueprintTitle { Anchor: (Left: 28, Right: 28, Top: 522, Height: 60); Style: (FontSize: 48, TextColor: #e2eaf0, RenderBold: true, HorizontalAlignment: Center); }
Label { Anchor: (Left: 28, Right: 28, Top: 586, Height: 34); Text: "PERMANENT EXPEDITION RECIPE"; Style: (FontSize: 26, TextColor: #eeb978, RenderBold: true, HorizontalAlignment: Center); }
Label #BlueprintCapability { Anchor: (Left: 28, Right: 28, Top: 630, Height: 40); Style: (FontSize: 27, TextColor: #55d9d1, RenderBold: true, HorizontalAlignment: Center); }
$A.@Section { Anchor: (Left: 54, Right: 54, Top: 686, Height: 154);
