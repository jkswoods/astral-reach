Label { Anchor: (Left: 126, Right: 18, Top: 100, Height: 28); Text: "Build with gathered materials"; Style: (FontSize: 23, TextColor: #9aafc2); }
}
Label #RevealNote { Anchor: (Left: 28, Right: 28, Top: 752, Height: 28); Style: (FontSize: 24, TextColor: #9aafc2, HorizontalAlignment: Center); }
