Group { Anchor: (Left: 326, Top: 26, Width: 1, Height: 72); Background: #3c5266; }
Label { Anchor: (Left: 354, Right: 30, Top: 42, Height: 44); Text: "ROCKET FUEL"; Style: (FontSize: 32, TextColor: #e2eaf0, RenderBold: true); }
Label { Anchor: (Left: 16, Right: 16, Top: 114, Height: 36); Text: "450 fuel saved per round trip"; Style: (FontSize: 32, TextColor: #e2eaf0, HorizontalAlignment: Center); }
Label { Anchor: (Left: 16, Right: 16, Top: 154, Height: 30); Text: "9,000 to 8,550 units"; Style: (FontSize: 27, TextColor: #9aafc2, HorizontalAlignment: Center); }
}
Label #RevealCapability { Anchor: (Left: 28, Right: 28, Top: 540, Height: 40); Style: (FontSize: 30, TextColor: #55d9d1, RenderBold: true, HorizontalAlignment: Center); }
$A.@Section #RevealBlueprintDetail { Anchor: (Left: 54, Right: 54, Top: 592, Height: 146);
